# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Leave blank to use local MongoDB at mongodb://127.0.0.1:27017/skillnova
MONGO_URI=

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET=skillnova-local-dev-secret

# ── Cloudinary (optional) ─────────────────────────────────────────────────────
# Fill in all three to enable cloud storage for payment screenshots and avatars.
# Leave blank to use in-memory storage (screenshots not persisted — dev only).
# Get your credentials at: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
# Set this in production. In local dev the CORS regex covers 192.168.x.x:5173.
FRONTEND_URL=
